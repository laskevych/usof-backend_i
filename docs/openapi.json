          "title": { "type": "string" },
          "content": { "type": "string" },
          "categories": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "required": ["title", "content", "categories"]
      },
      "UpdatePost": {
        "type": "object",
        "properties": {
