        "properties": {
          "id": { "type": "integer" },
          "login": { "type": "string" },
          "fullName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "isVerified": { "type": "boolean", "example": false },
          "profilePicture": { "type": "string", "example": "default.png"  },
