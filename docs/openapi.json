          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["user", "admin"] },
          "fullName": { "type": "string" }
        },
        "required": ["login", "password", "password_confirmation", "email", "role"]
      },
      "CreateLike": {
